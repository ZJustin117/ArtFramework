# ArtFramework local machine config (copy to .env.local and fill).
# Never commit .env.local. Shared docs only reference these names.
#
# Use local STS / Amethyst paths and ArtFramework-specific ART_* names.
# STS_CONNECTOR_PORT and SLAY_THE_AMETHYST_ROOT are Amethyst tooling keys.

# --- Build (JUnit / jar) ---
SLAY_THE_AMETHYST_ROOT=
ART_STS_JAR=
# Optional; if empty, local-env may derive from SLAY_THE_AMETHYST_ROOT:
#   $SLAY_THE_AMETHYST_ROOT/app/src/main/assets/components/mods/BaseMod.jar
#   $SLAY_THE_AMETHYST_ROOT/app/src/main/assets/components/mods/ModTheSpire.jar
ART_BASEMOD_JAR=
ART_MODTHESPIRE_JAR=

# --- Optional local STS2 developer assets (never packaged into release jars) ---
# Source checkout containing animations/; used only by scripts/package-sts2-assets.sh
ART_STS2_ROOT=
# Optional generated bundle path for standalone assets tests.
ART_STS2_ASSET_JAR=
# Optional D1 device-side asset directory (defaults to the app's private files/sts/art-assets).
ART_D1_ASSET_DIR=
# Optional local Spine 4.2 runtime jar used by the D1 deployment script.
ART_SPINE42_RUNTIME_JAR=

# --- Android deploy + UI device lab (see docs/development/android-device-lab.md) ---
# ADB serial for optional single-device UI verification.
ART_D1_SERIAL=
ART_D2_SERIAL=

# Connector daemon port on the developer machine.
STS_CONNECTOR_PORT=

# Absolute SlayTheAmethyst scripts/tools (default: $SLAY_THE_AMETHYST_ROOT/scripts/tools)
ART_AMETHYST_TOOLS_DIR=

# Absolute harness OutDir (gitignored debug-artifacts recommended)
ART_HARNESS_OUT_DIR=

# Device-side game-probe port (Amethyst harness default)
ART_GAME_PROBE_PORT=9099

# Device-side Arthas bridge port (optional JVM diagnostics).
ART_ARTHAS_PORT=8099

# Optional: tools/art-verify result JSON directory
# ART_UI_VERIFY_OUT_DIR=

# Optional: ./scripts/publish-art-local.sh install targets
# ART_INSTALL_DIR=
# ART_CONSUMER_JAR=
