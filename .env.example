# SpireUI local machine config (copy to .env.local and fill).
# Never commit .env.local. Shared docs only reference these names.
#
# Values can be copied from CrossSpire .env.local; rename CROSSSPIRE_* → SPIREUI_*
# where noted. STS_CONNECTOR_PORT and SLAY_THE_AMETHYST_ROOT are shared Amethyst keys.

# --- Build (JUnit / jar) ---
SLAY_THE_AMETHYST_ROOT=
SPIREUI_STS_JAR=
# Optional; if empty, local-env may derive from SLAY_THE_AMETHYST_ROOT:
#   $SLAY_THE_AMETHYST_ROOT/app/src/main/assets/components/mods/BaseMod.jar
#   $SLAY_THE_AMETHYST_ROOT/app/src/main/assets/components/mods/ModTheSpire.jar
SPIREUI_BASEMOD_JAR=
SPIREUI_MODTHESPIRE_JAR=

# --- Android deploy + UI device lab (see docs/development/android-device-lab.md) ---
# Same physical serial as CrossSpire CROSSSPIRE_D1_SERIAL when co-testing.
SPIREUI_D1_SERIAL=
SPIREUI_D2_SERIAL=

# Connector daemon port on the developer machine (shared with CrossSpire / Amethyst)
STS_CONNECTOR_PORT=

# Absolute SlayTheAmethyst scripts/tools (default: $SLAY_THE_AMETHYST_ROOT/scripts/tools)
SPIREUI_AMETHYST_TOOLS_DIR=

# Absolute harness OutDir (gitignored debug-artifacts recommended)
SPIREUI_HARNESS_OUT_DIR=

# Device-side game-probe port (Amethyst harness default)
SPIREUI_GAME_PROBE_PORT=9099

# Optional: tools/ui-verify result JSON directory
# SPIREUI_UI_VERIFY_OUT_DIR=

# Optional: ./scripts/publish-local.sh install targets
# SPIREUI_INSTALL_DIR=
# SPIREUI_CONSUMER_JAR=
