# SpireUI local machine config (copy to .env.local and fill).
# Never commit .env.local. Shared docs only reference these names.
#
# Values can be copied from CrossSpire .env.local, but key NAMES are SPIREUI_*.

# SlayTheAmethyst checkout root (or equivalent assets root)
SLAY_THE_AMETHYST_ROOT=

# Absolute path to STS desktop-1.0.jar
SPIREUI_STS_JAR=

# BaseMod / ModTheSpire jars (often under Amethyst assets).
# If unset, local-env plugin may derive from SLAY_THE_AMETHYST_ROOT:
#   $SLAY_THE_AMETHYST_ROOT/app/src/main/assets/components/mods/BaseMod.jar
#   $SLAY_THE_AMETHYST_ROOT/app/src/main/assets/components/mods/ModTheSpire.jar
SPIREUI_BASEMOD_JAR=
SPIREUI_MODTHESPIRE_JAR=

# Optional: Android deploy (@android-deploy-jar) + UI verify (@ui-verify). Default target is D1 only.
# Serial values may match CrossSpire CROSSSPIRE_D1_SERIAL / D2; rename keys to SPIREUI_*.
# Example (match CrossSpire local adb forwards): localhost:15555
SPIREUI_D1_SERIAL=
SPIREUI_D2_SERIAL=

# Optional: tools/ui-verify result JSON directory (default: debug-artifacts/ui-verify)
# SPIREUI_UI_VERIFY_OUT_DIR=

# Optional: ./scripts/publish-local.sh install targets
# SPIREUI_INSTALL_DIR=
# SPIREUI_CONSUMER_JAR=
