{
  "type": "window",
  "id": "comp_sample",
  "title": "Composition Sample",
  "width": 400,
  "height": 280,
  "pad": 8,
  "gap": 6,
  "children": [
    {
      "type": "col",
      "id": "main_col",
      "pad": 4,
      "gap": 6,
      "grow": true,
      "children": [
        { "type": "label", "id": "hello", "text": "Hello composition" },
        {
          "type": "row",
          "id": "actions",
          "gap": 8,
          "children": [
            { "type": "button", "id": "ok", "text": "OK", "grow": true },
            { "type": "button", "id": "cancel", "text": "Cancel", "grow": true }
          ]
        },
        {
          "type": "slider",
          "id": "intensity",
          "min": 0,
          "max": 1,
          "value": 0.5,
          "effects": [{ "id": "glow", "params": { "intensity": 0.5 } }]
        },
        {
          "type": "hitarea",
          "id": "card_zone",
          "width": 200,
          "height": 80
        }
      ]
    }
  ]
}
