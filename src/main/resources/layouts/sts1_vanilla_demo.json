{
  "type": "window",
  "id": "sts1_vanilla_demo",
  "title": "STS1 Vanilla Nodes",
  "width": 840,
  "height": 640,
  "pad": 12,
  "gap": 8,
  "children": [
    {
      "type": "art.sts.panel",
      "id": "vanilla_panel",
      "height": 520,
      "pad": 10,
      "gap": 8,
      "children": [
        { "type": "label", "id": "heading", "text": "HOSTASSETS VANILLA CONTROLS" },
        {
          "type": "row",
          "id": "actions",
          "gap": 10,
          "children": [
            { "type": "art.sts.button", "id": "end_turn", "variant": "end_turn", "width": 180, "height": 64 },
            { "type": "art.sts.event_option", "id": "event_option", "enabled": true, "width": 260, "height": 48 },
            { "type": "art.sts.room_action", "id": "rest_action", "room": "rest", "width": 96, "height": 64 }
          ]
        },
        {
          "type": "row",
          "id": "combat_row",
          "gap": 12,
          "children": [
            { "type": "art.sts.card", "id": "card", "width": 150, "height": 210 },
            { "type": "art.sts.energy_orb", "id": "energy", "color": "red", "width": 90, "height": 90 },
            { "type": "art.sts.intent", "id": "intent", "width": 72, "height": 72 },
            { "type": "art.sts.top_panel", "id": "top_panel", "width": 300, "height": 42 }
          ]
        },
        {
          "type": "art.sts.map",
          "id": "map",
          "act": "act1",
          "height": 190,
          "children": [
            { "type": "art.sts.map_node", "id": "monster", "kind": "monster", "width": 64, "height": 64 },
            { "type": "art.sts.map_node", "id": "elite", "kind": "elite", "width": 64, "height": 64 },
            { "type": "art.sts.map_node", "id": "treasure", "kind": "treasure", "width": 64, "height": 64 }
          ]
        },
        { "type": "art.sts.reward_item", "id": "reward", "width": 360, "height": 48 }
      ]
    }
  ]
}
